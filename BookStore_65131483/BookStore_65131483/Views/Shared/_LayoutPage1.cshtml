<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookStore - Tiệm Sách Bình Yên</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />
    <link href="~/Content/StyleSheet1.css" rel="stylesheet"/>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <header>
        <div class="container navbar">
            <a href="@Url.Action("Index", "Home")" class="logo"><i class="fas fa-book-open"></i> ZenBooks</a>

           

            <nav class="nav-links">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="@Url.Action("TimKiem", "TimKiem")">Sách Mới</a>
                <a href="#">Best Seller</a>
                <a href="#">Blog</a>
            </nav>

            <div class="icons">
                <a href="#"><i class="far fa-heart"></i></a>
                <a href="@Url.Action("XemGioHang", "DonHang")"><i class="fas fa-shopping-cart"></i></a>
                <a href="@Url.Action("TaiKhoan", "TaiKhoan")"><i class="far fa-user"></i></a>
            </div>
        </div>
    </header>
    <div >@RenderBody()</div>
    <footer>
        <div class="container">
            <h3>ZenBooks</h3>
            <p>Nơi lưu giữ những giá trị tri thức.</p>
            <br />
            <p>&copy; 2024 ZenBooks Store. Designed with ❤️.</p>
        </div>
    </footer>
</body>
</html>

@RenderSection("scripts", required: false)
