@model IEnumerable<BookStore_65131483.Models.DONHANG>




@{
    ViewBag.Title = "Quản lý đơn hàng";

    var grid = new WebGrid(
        source: Model,
        rowsPerPage: 8,     // số dòng mỗi trang
        canPage: true,      // cho phép phân trang
        canSort: true       // cho phép sắp xếp
    );
    Layout = "~/Views/Shared/_LayoutAccountPage.cshtml";
}


<style>
    /* Tùy chỉnh bảng chung */
    .grid-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px; /* Tạo khoảng cách giữa các dòng */
        background: transparent !important;
        border: none !important;
    }

        .grid-table thead th {
            background-color: #f8f9fa !important;
            color: #495057;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 13px;
            padding: 15px;
            border: none !important;
        }

        .grid-table tbody tr {
            background-color: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }

        /*            .grid-table tbody tr:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }*/

        .grid-table td {
            padding: 15px !important;
            vertical-align: middle !important;
            border: none !important;
        }

    /* Định dạng nội dung ô */
    .order-id {
        font-weight: 700;
        color: #2c3e50;
    }

    .order-price {
        font-weight: 700;
        color: #e67e22;
    }

    /* Trạng thái Badge */
    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-success {
        background: #f0fdf4;
        color: #15803d;
    }

    .status-danger {
        background: #fef2f2;
        color: #991b1b;
    }

    /* Nút thao tác */
    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: 0.2s;
    }

    .btn-view {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-view:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

    .btn-cancel {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-cancel:hover {
            background: #fecaca;
        }

    .btn-rate {
        background: #fef9c3;
        color: #a16207;
    }

        .btn-rate:hover {
            background: #fef08a;
        }

    .grid-footer {
        text-align: center
    }
</style>



@grid.GetHtml(
    tableStyle: "table grid-table",
    footerStyle: "grid-footer",
    fillEmptyRows: false,
    alternatingRowStyle: "alternatingRowStyle",
    columns: new[]
    {
        grid.Column("STT", style: "col-stt", format: (item) => item.WebGrid.Rows.IndexOf(item) + 1 + grid.PageIndex * grid.RowsPerPage),

        grid.Column(header: "Mã đơn hàng", format: @<text><span class="order-id">#@item.MaDH</span></text>),

grid.Column("TongTien", "Tổng tiền", format: @<text><span class="order-price">@item.TongTien.ToString("N0")đ</span></text>),

grid.Column("TrangThai", "Trạng thái", format: (item) => {
string statusClass = "";
string statusText = item.TrangThai;

if (item.TrangThai == "Chờ xử lý") statusClass = "status-pending";
else if (item.TrangThai == "HoanThanh") { statusClass = "status-success"; statusText = "Hoàn thành"; }
else if (item.TrangThai == "Đã hủy") statusClass = "status-danger";
else if (item.TrangThai == "DangVanChuyen") { statusClass = "status-success"; statusText = "Đang vận chuyển"; }


return Html.Raw($"<span class='badge-status {statusClass}'>{statusText}</span>");
}),

grid.Column("NgayDat", "Ngày đặt", format: (item) => item.NgayDat.ToString("dd/MM/yyyy")),

grid.Column(
header: "Thao tác",
style: "col-action",
format: @<text>
    <div class="action-buttons">
        @* Nút xem chi tiết luôn hiển thị *@
        <a class="btn-action btn-view" href="@Url.Action("ChiTietDonHang", "TaiKhoan", new { maDH = item.MaDH })" title="Xem chi tiết">
            <i class="bi bi-eye-fill"></i> Xem
        </a>

        @* Nút Hủy đơn *@
        @if (item.TrangThai == "Chờ xử lý")
{
        <a class="btn-action btn-cancel"
           href="@Url.Action("HuyDon", "TaiKhoan", new { maDH = item.MaDH })"
           onclick="return confirm('Bạn có chắc muốn hủy đơn hàng?')">
            <i class="bi bi-x-circle"></i> Hủy
        </a>
}


        @* Nút Đánh giá *@
        @if (item.TrangThai == "HoanThanh")
                    {
        <a class="btn-action btn-rate" href="@Url.Action("DanhGia", "DanhGia", new { maDH = item.MaDH })">
            <i class="bi bi-star-fill"></i> Đánh giá
        </a>
                    }
    </div>
</text>
)
}
)
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
