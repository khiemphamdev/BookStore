@model IEnumerable<BookStore_65131483.Models.TAIKHOAN>


@{
    ViewBag.Title = "Quản lý tài khoản";

    var grid = new WebGrid(
        source: Model,
        rowsPerPage: 5,     // số dòng mỗi trang
        canPage: true,      // cho phép phân trang
        canSort: true       // cho phép sắp xếp
    );
    Layout = "~/Views/Shared/_LayoutAdminPage.cshtml";
}
<style>
    .grid-footer {
        width: 100%;
        text-align: center;
    }
</style>
<h3>Quản lý khách hàng</h3>

@grid.GetHtml(
    tableStyle: "table table-bordered table-striped",
    headerStyle: "thead-dark",
    footerStyle: "grid-footer",
    fillEmptyRows: true,
    alternatingRowStyle: "alternatingRowStyle",
    columns: new[]
    {
        grid.Column("STT", format: (item) => item.WebGrid.Rows.IndexOf(item) + 1 + grid.PageIndex * grid.RowsPerPage),
        grid.Column("TenDangNhap", "Tên đăng nhập"),
        grid.Column("HoTen", "Họ tên"),
        grid.Column("Email", "Email"),
        grid.Column("SDT", "SĐT"),
        grid.Column("DiaChi", "Địa chỉ"),

        grid.Column(
            header: "Hành động",
            format: item => Html.Raw(
                $"<a class='btn btn-warning btn-sm' href='{Url.Action("EditUser", "TrangAdmin", new { id = item.MaTK })}'>Sửa</a> " +
                $"<a class='btn btn-danger btn-sm' href='{Url.Action("DeleteUser", "TrangAdmin", new { id = item.MaTK })}' " +
                $"onclick='return confirm(\"Xóa tài khoản này?\")'>Xóa</a>"
                )

        )
    }
)
