@model IEnumerable<BookStore_65131483.Models.DONHANG>




@{
    ViewBag.Title = "Quản lý đơn hàng";

    var grid = new WebGrid(
        source: Model,
        rowsPerPage: 5,     // số dòng mỗi trang
        canPage: true,      // cho phép phân trang
        canSort: true       // cho phép sắp xếp
    );
    Layout = "~/Views/Shared/_LayoutAdminPage.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    .grid-footer {
        width: 100%;
        text-align: center;
    }

    .col-stt {
        width: 50px;
        text-align: center;
    }

    .col-ngay {
        width: 110px;
        white-space: nowrap;
    }

    .col-pttt {
        width: 140px;
        white-space: nowrap;
    }

    .action-group {
        white-space: nowrap;
        gap: 10px;
    }

        .action-group .btn {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .action-group i {
            font-size: 14px;
        }

    .primary-button {
        background-color: #0d6efd; /* xanh biển */
        border-color: #0d6efd;
        color: white
    }

        .primary-button:hover {
            background-color: #0b5ed7;
            border-color: #0b5ed7;
        }

    .action-button {
        background-color: #198754; /* xanh lá */
        border-color: #198754;
    }
</style>
<h2>Quản lý tài khoản</h2>

<a href="@Url.Action("Create")" class="btn btn-success">➕ Thêm tài khoản</a>

@grid.GetHtml(
    tableStyle: "table table-bordered table-striped",
    headerStyle: "thead-dark",
    footerStyle: "grid-footer",
    fillEmptyRows: true,
    alternatingRowStyle: "alternatingRowStyle",
    columns: new[]
    {
        grid.Column("STT" ,  style: "col-stt", format: (item) => item.WebGrid.Rows.IndexOf(item) + 1 + grid.PageIndex * grid.RowsPerPage),
       @grid.Column(
            header: "Tài khoản",
            format: item => Html.Raw(
            "<b>" + item.TAIKHOAN.HoTen + "</b><br/>" +
            "<span>Email: " + item.TAIKHOAN.Email + "</span><br/>" +
            "<span>SDT: " + item.TAIKHOAN.SDT + "</span> " +
             " <br/> <span>Địa chỉ: " + item.TAIKHOAN.DiaChi + "</span> "
            )
       ),

        grid.Column("TongTien", "Tổng tiền"),
        grid.Column("TrangThai", "Trạng thái"),
        grid.Column("NgayDat", "Ngày đặt", style: "col-ngay"),
        grid.Column("PhuongThucThanhToan", "Phương thức", style: "col-pttt"),

        grid.Column(
    header: "Hành động",
    format: item => Html.Raw(
        "<div class='btn-group btn-group-sm action-group'>" +

            "<a class='btn btn-outline-warning primary-button' href='" +
                Url.Action("XemCTDH", "TrangAdmin_65131483", new { maDH = item.MaDH }) +
            "'>" +
                "<i class='bi bi-eye'></i> Xem" +
            "</a>" +

            "<button class='btn btn-warning dropdown-toggle dropdown-toggle-split action-button' " +
                    "type='button' data-bs-toggle='dropdown'> Hành động</button>" +

            "<ul class='dropdown-menu'>" +
                "<li><a class='dropdown-item' href='#'>Hủy</a></li>" +
                "<li><a class='dropdown-item text-success' href='" +
                    Url.Action("CapNhatTrangThai", "TrangAdmin_65131483", new { maDH = item.MaDH, trangThai = 2 }) +
                "'>Đang vận chuyển</a></li>" +
                "<li><a class='dropdown-item text-success' href='" +
                    Url.Action("CapNhatTrangThai", "TrangAdmin_65131483", new { maDH = item.MaDH, trangThai = 3 }) +
                    "'>Đã giao hàng</a></li>" +

                "<li><a class='dropdown-item text-danger' href='" +
                    Url.Action("CapNhatTrangThai", "TrangAdmin_65131483", new { maDH = item.MaDH, trangThai = 1 }) +
                "' onclick='return confirm(\"Bạn có chắc muốn xóa?\")'>Xóa</a></li>" +
            "</ul>" +

        "</div>"
    )
)

    }
)
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
